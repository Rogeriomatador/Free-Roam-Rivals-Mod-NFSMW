// Windows Explorer VERSIONINFO for the current ASI. Generated by CMake:
 // source version is the project() declaration, not a duplicated string.
#include <winver.h>

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName", "Rogeriomatador\0"
            VALUE "FileDescription", "Need for Speed Most Wanted (2005) - Free Roam Rivals ASI\0"
            VALUE "FileVersion", "@PROJECT_VERSION@-dev\0"
            VALUE "InternalName", "FreeRoamRivals.asi\0"
            VALUE "OriginalFilename", "FreeRoamRivals.asi\0"
            VALUE "ProductName", "Free Roam Rivals\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@-dev\0"
            VALUE "LegalCopyright", "Free Roam Rivals contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
